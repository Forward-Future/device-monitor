#!/bin/bash
n=$(_counter net)
cat <<X
Name       Mtu   Network       Address            Ipkts Ierrs     Ibytes    Opkts Oerrs     Obytes  Coll
lo0        16384 <Link#1>                        1000     0     200000     1000     0     200000     0
lo0        16384 127           127.0.0.1         1000     -     200000     1000     -     200000     -
en0        1500  <Link#11>   a4:83:e7:12:34:56  5000000     0 $((6000000000 + n * 4000000))  3000000     0 $((1500000000 + n * 1000000))     0
en0        1500  192.168.1     192.168.1.77     5000000     - $((6000000000 + n * 4000000))  3000000     - $((1500000000 + n * 1000000))     -
utun0      1380  <Link#19>                          10     0       1000       12     0       2000     0
X
